# ─────────────────────────────────────────────
# The Social — Backend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=8000

# MongoDB Atlas
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/the-social?retryWrites=true&w=majority

# JWT — used by authMiddleware to verify API tokens
# Must be DIFFERENT from NEXTAUTH_SECRET
# Generate: openssl rand -base64 32
JWT_SECRET=my-very-trong-jt-ecret

# Cloudinary — media storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Redis — response caching + Socket.IO pub/sub adapter
# Local dev: redis://localhost:6379
# Production: use Upstash or managed Redis URL
REDIS_URL=redis://localhost:6379

# CORS — must match the deployed frontend origin exactly
# Local dev: http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Sentry — error monitoring (optional; leave blank to disable)
SENTRY_DSN=

# ─────────────────────────────────────────────
# AI Microservices (gateway → internal services)
# The backend calls these on the internal network only; the frontend never does.
# ─────────────────────────────────────────────

# Recommendation Service base URL (internal).
# Docker Compose: http://rec-service:8001 — Local host run: http://localhost:8001
REC_SERVICE_URL=http://localhost:8001

# AI Chat (RAG) Service base URL (internal) — reserved; service arrives in a later phase.
CHAT_SERVICE_URL=

# Shared secret the gateway sends as X-Internal-Token on every internal call.
# Must match INTERNAL_SERVICE_TOKEN in each Python service.
# Generate: openssl rand -base64 32
INTERNAL_SERVICE_TOKEN=

# Feature flag: when "true", the gateway consults the Recommendation Service for
# feeds (with heuristic fallback). Stays "false" until the feed is wired.
REC_SERVICE_ENABLED=false

# Reel event stream (gateway → Recommendation Service ingestion).
# When "true", trackReelEvent additionally dual-writes raw events to a Redis
# Stream (this dual-write is wired in a later batch). Default "false" → no
# dual-write occurs and behavior is identical to today.
REC_EVENT_STREAM_ENABLED=false
REEL_EVENTS_STREAM_KEY=reel:events
REEL_EVENTS_STREAM_MAXLEN=1000000

# ─────────────────────────────────────────────
# Razorpay — creator tipping + paid server tiers (India-focused)
# Leave RAZORPAY_KEY_ID/RAZORPAY_KEY_SECRET blank to keep the whole feature
# disabled (every payments endpoint 503s cleanly; no UI is shown). Requires
# a real Razorpay business account (test-mode keys for development) — these
# can't be self-generated, unlike VAPID keys below.
#
# COLLECT-ONLY MODEL: tips and tier subscriptions settle to the platform's
# own Razorpay account, not split automatically to each creator. Razorpay
# Route (their equivalent of Stripe Connect, for automatic payment
# splitting) requires the platform itself to have ₹40L+ domestic turnover
# under RBI rules effective September 2025 — not realistic for a new
# platform. What each creator is owed is tracked in Mongo (Tip/
# TierSubscription) and paid out manually/separately for now; see
# razorpayClient.ts's header comment.
#
# The frontend never needs its own copy of this key — every endpoint that
# starts a payment (createTipOrder, createTierSubscription) returns keyId
# in its response for the Checkout modal to use, sourced from
# RAZORPAY_KEY_ID here.
#
# Webhook: register https://<your-api>/api/v1/payments/webhook in the
# Razorpay dashboard for payment.captured, payment.failed,
# subscription.activated, subscription.charged, subscription.pending,
# subscription.halted, subscription.cancelled, subscription.completed,
# subscription.expired.
# ─────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Platform's cut of every tip and tier subscription, as a percentage (0-100)
# — bookkeeping only under the collect-only model above, not an actual
# Razorpay Route split at charge time.
RAZORPAY_PLATFORM_FEE_PERCENT=10

# ─────────────────────────────────────────────
# Web Push (VAPID) — real browser/PWA push notifications
# Unlike FCM/APNs, this needs NO external account — the keypair is
# self-generated and authenticates directly with each browser's own push
# service. Leave blank to disable (push fan-out becomes a silent no-op).
# Generate: node -e "console.log(require('web-push').generateVAPIDKeys())"
# ─────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com
